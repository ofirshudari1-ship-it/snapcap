# Build artifacts — rebuilt from source via build/build_exe.bat + PyInstaller,
# never committed (PyInstaller-generated .spec files carry absolute machine
# paths and are regenerated too).
build/dist/
build/pyinstaller_work/
build/pyinstaller-work/
build/installer_dist/
build/*.spec
*.spec

# The distributable installer ships as a GitHub Release ASSET, never as a
# repo file (it's 100+ MB and machine-built).
/*.exe

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Logs
*.log
